<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- تم تغيير اسم علامة التبويب هنا لتظهر باسم FATMA -->
    <title>FATMA ♥</title>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5ebe6 0%, #e6ccb2 100%);
            font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
            position: relative;
        }
        
        /* تأثير القلوب المتساقطة في الخلفية */
        .heart-bg {
            position: absolute;
            color: #7f5539;
            font-size: 20px;
            opacity: 0.3;
            animation: fall linear infinite;
            z-index: 1;
            user-select: none;
        }
        @keyframes fall {
            0% { transform: translateY(-10vh) rotate(0deg); opacity: 0; }
            10% { opacity: 0.4; }
            90% { opacity: 0.4; }
            100% { transform: translateY(110vh) rotate(360deg); opacity: 0; }
        }

        .container {
            text-align: center;
            z-index: 10;
            padding: 20px;
            width: 100%;
            max-width: 600px;
        }

        /* القلب الكبير النابض */
        .main-heart {
            font-size: 80px;
            color: #7f5539;
            margin-bottom: -10px;
            animation: pulse 1.5s infinite;
            display: inline-block;
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }

        /* الاسم الرئيسي */
        h1 {
            font-size: 4rem;
            color: #7f5539;
            margin: 10px 0;
            font-family: 'Georgia', serif;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* منطقة الجمل المتغيرة */
        .text-box {
            min-height: 80px;
            margin: 20px 0;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .message {
            font-size: 1.8rem;
            color: #2b1d0c;
            font-weight: bold;
            line-height: 1.6;
            padding-left: 8px;
            overflow: hidden;
        }

        /* زر كمان */
        .btn {
            background-color: #583110;
            color: #fff;
            border: none;
            padding: 12px 35px;
            font-size: 1.2rem;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
            font-weight: bold;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn:hover {
            background-color: #7f5539;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        }
        .btn:active {
            transform: translateY(-1px);
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="main-heart">♥</div>
        <!-- تم تعديل الاسم هنا ليصبح FATMA -->
        <h1>FATMA</h1> 
        
        <div class="text-box">
            <div class="message" id="msg">كل حاجة حلوة في الدنيا فيها شبهك..</div>
        </div>

        <button class="btn" onclick="nextMessage()">♥ كمان</button>
    </div>

    <script>
        // الجمل المتغيرة التي ستظهر بالتوالي عند الضغط على زر كمان (تم تعديل الاسم داخل الجمل أيضاً لـ فاطمة)
        const messages = [
            "كل حاجة حلوة في الدنيا فيها شبهك يا فاطمة..",
            "بسببك أكتر من أي كلمة تقدر تتقال..",
            "وجودك جنبي بيخلي الدنيا أهدى وأحلى..",
            "إنتي مش بس اسم حلو، إنتي أحلى حاجة حصلتلي..",
            "قلبي لما بيدق، بيقول اسمك.. ♥"
        ];

        let currentIndex = 0;

        function nextMessage() {
            currentIndex = (currentIndex + 1) % messages.length;
            const msgElement = document.getElementById('msg');
            msgElement.innerText = messages[currentIndex];
        }

        // كود توليد القلوب المتساقطة تلقائياً في الخلفية
        function createHearts() {
            for (let i = 0; i < 30; i++) {
                let heart = document.createElement('div');
                heart.className = 'heart-bg';
                heart.innerText = '♥';
                heart.style.left = Math.random() * 100 + 'vw';
                heart.style.top = Math.random() * -20 + 'vh';
                heart.style.animationDuration = (Math.random() * 3 + 4) + 's';
                heart.style.animationDelay = Math.random() * 5 + 's';
                heart.style.fontSize = (Math.random() * 15 + 15) + 'px';
                document.body.appendChild(heart);
            }
        }
        createHearts();
    </script>
</body>
</html>
